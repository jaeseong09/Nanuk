{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "allowJs": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/schema/parse-schema.js"
  ]
}
